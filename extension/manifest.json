{
  "manifest_version": 3,
  "name": "Bybit PnL Summary",
  "version": "1.1.1",
  "description": "Parses the Bybit Transaction Log and shows a summary: profit, loss, fees, funding, ROI, and breakdowns by contract, trade and day.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Bybit PnL: show/hide summary"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.bybit.com/*",
        "https://*.bybit.global/*",
        "https://*.bybit.nl/*",
        "https://*.bybit.eu/*",
        "https://*.bybit.kz/*",
        "https://*.bybit.tr/*",
        "https://*.bybit-tr.com/*",
        "https://*.bybitglobal.com/*"
      ],
      "js": [
        "i18n.js",
        "parser.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
